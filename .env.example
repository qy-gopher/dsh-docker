DSH_IMAGE=ghcr.io/qy-gopher/dsh-docker:latest

# Access from this machine. For LAN access, see README.md.
DSH_PUBLISH_ADDRESS=127.0.0.1
DSH_PUBLISH_PORT=3080
DSH_PUBLIC_URL=http://localhost:3080/
DSH_TRUSTED_HOSTS=

# Optional: configure the key here, or save it in DSH's Models settings.
DEEPSEEK_API_KEY=
TZ=Asia/Shanghai
DSH_PERMISSION_MODE=workspace-write

# Set to 1 for one startup when restoring a home owned by another UID.
DSH_FIX_PERMISSIONS=0

# Optional outbound proxy for model, IM, and CLI traffic.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
http_proxy=
HTTPS_PROXY=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
